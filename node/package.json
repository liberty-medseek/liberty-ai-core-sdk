{
  "name": "@libertyti/ai",
  "version": "0.1.0",
  "description": "Cliente do Liberty AI Gateway.",
  "license": "MIT",
  "author": "Liberty TI",
  "homepage": "https://github.com/liberty-medseek/liberty-ai-core-sdk/tree/main/node",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liberty-medseek/liberty-ai-core-sdk.git",
    "directory": "node"
  },
  "bugs": {
    "url": "https://github.com/liberty-medseek/liberty-ai-core-sdk/issues"
  },
  "keywords": [
    "liberty",
    "gateway",
    "llm",
    "openai-compatible"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run test",
    "prepublishOnly": "npm run check && npm run build"
  },
  "dependencies": {
    "openai": "^6.0.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
